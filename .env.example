# Canonical origin (no trailing slash). Used for metadata, robots, sitemap.
NEXT_PUBLIC_SITE_URL=https://revelat.live

# --- Waitlist sink (first match wins; if none set, signups accepted but not stored) ---

# Option A: Supabase table (shared with the main app). Run supabase/waitlist.sql once.
# SERVICE-ROLE key only — server-side, secret, NEVER prefix NEXT_PUBLIC.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# Option B: Resend Audiences — https://resend.com/docs/api-reference/contacts
# RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Welcome email (independent of the sink above) ---
# Set RESEND_API_KEY + verify revelat.live in Resend → each signup gets a branded
# "you're in" email. Without it, signups still store; they just get no email.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=REVÉLAT <hello@revelat.live>
# RESEND_REPLY_TO=hello@revelat.live

# Option B: Generic webhook (Zapier / n8n / your own endpoint)
# WAITLIST_WEBHOOK_URL=https://hooks.example.com/waitlist
